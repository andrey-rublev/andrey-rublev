{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nk-visits-badge",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    // Your Cloudflare account id (not a secret - it is safe in source).
    // Dashboard -> any domain -> right sidebar -> Account ID.
    "CF_ACCOUNT_ID": "734ed893836d1463e4139d4054b63ea1",

    // "all" walks backwards in 90-day chunks (Cloudflare caps a single
    // query at 13w2d) and sums them, stopping where the data runs out.
    "DAYS": "all",

    // "pageviews" matches a "views" label; "visits" counts sessions instead.
    "METRIC": "pageviews",

    "BADGE_LABEL": "portfolio views",

    "BADGE_COLOR": "818CF8"
    // "SITE_TAG": "..."              // only if >1 site has data
  }
  // CF_API_TOKEN is a secret - never put it here.
  // Set it with: npx wrangler secret put CF_API_TOKEN
}
